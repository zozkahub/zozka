RunService.RenderStepped:Connect(function()
    if not MainFrame.Parent or not NetworkFrame.Visible then return end
    local mousePos = UserInputService:GetMouseLocation()
    local framePos = MainFrame.AbsolutePosition
    local relMouse = mousePos - framePos - Vector2.new(0, 36)
    for _, n in ipairs(nodes) do
        n.pos = n.pos + n.vel
        if n.pos.X < 0 or n.pos.X > 380 then n.vel = Vector2.new(-n.vel.X, n.vel.Y) end
        if n.pos.Y < 0 or n.pos.Y > 520 then n.vel = Vector2.new(n.vel.X, -n.vel.Y) end
        if (n.pos - relMouse).Magnitude < 70 then n.pos = n.pos + (n.pos - relMouse).Unit * 1.5 end
        n.gui.Position = UDim2.new(0, n.pos.X, 0, n.pos.Y)
    end
    local lineIdx = 1
    for i = 1, #nodes do
        for j = i + 1, #nodes do
            local p1, p2 = nodes[i].pos, nodes[j].pos
            local dist = (p1 - p2).Magnitude
            local line = lines[lineIdx]
            if dist < 80 then
                line.Visible = true; line.Position = UDim2.new(0, (p1.X+p2.X)/2, 0, (p1.Y+p2.Y)/2); line.Size = UDim2.new(0, dist, 0, 1); line.Rotation = math.deg(math.atan2(p2.Y - p1.Y, p2.X - p1.X)); line.BackgroundTransparency = dist / 80
            else line.Visible = false end
            lineIdx = lineIdx + 1
        end
    end
end)

